generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int               @id @default(autoincrement())
  name            String
  email           String            @unique @db.VarChar(255)
  username        String            @unique @db.VarChar(100)
  passwordHash    String            @db.VarChar(255)
  resetToken      String?           @db.VarChar(255)
  resetTokenExp   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  profile         Profile?
  subscription    Subscription?
  projects        Project[]
  skills          Skill[]
  socialLinks     SocialLink[]
  portfolioViews  PortfolioView[]
  contactMessages ContactMessage[]
  customDomains   CustomDomain[]
  versions        VersionSnapshot[]

  @@index([username])

  @@map("codefolio_users")
}

model Profile {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  username       String          @unique @db.VarChar(100)
  displayName    String          @db.VarChar(150)
  headline       String?         @db.VarChar(200)
  bio            String?         @db.Text
  location       String?         @db.VarChar(100)
  profileImage   String?         @db.VarChar(500)
  resumeUrl      String?         @db.VarChar(500)
  templateId     Int?
  themeMode      ThemeMode       @default(LIGHT)
  accentColor    String?         @db.VarChar(7)
  githubUsername String?         @db.VarChar(100)
  linkedinUrl    String?         @db.VarChar(500)
  websiteUrl     String?         @db.VarChar(500)
  status         PortfolioStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id])

  @@index([userId])
  @@index([username])

  @@map("codefolio_profiles")
}

enum ThemeMode {
  LIGHT
  DARK
  SYSTEM
}

enum PortfolioStatus {
  DRAFT
  PUBLISHED
}

model Template {
  id           Int       @id @default(autoincrement())
  name         String
  slug         String    @unique
  description  String?
  previewImage String?
  isPremium    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  profiles Profile[]

  @@map("codefolio_templates")
}

model Project {
  id            Int      @id @default(autoincrement())
  userId        Int
  title         String   @db.VarChar(200)
  slug          String   @unique @db.VarChar(250)
  description   String?  @db.Text
  techStack     String?  @db.VarChar(500)
  repoUrl       String?  @db.VarChar(500)
  liveUrl       String?  @db.VarChar(500)
  screenshotUrl String?  @db.VarChar(500)
  featured      Boolean  @default(false)
  displayOrder  Int      @default(0)
  problem       String?  @db.Text
  solution      String?  @db.Text
  impact        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_projects")
}

model Skill {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String   @db.VarChar(100)
  category     String   @db.VarChar(100)
  proficiency  Int      @default(0)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_skills")
}

model SocialLink {
  id           Int      @id @default(autoincrement())
  userId       Int
  platform     String   @db.VarChar(100)
  url          String   @db.VarChar(500)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_social_links")
}

model PortfolioView {
  id        Int      @id @default(autoincrement())
  userId    Int
  ipHash    String   @db.VarChar(64)
  userAgent String?  @db.VarChar(500)
  referrer  String?  @db.VarChar(500)
  viewedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([viewedAt])

  @@map("codefolio_portfolio_views")
}

model ContactMessage {
  id          Int           @id @default(autoincrement())
  userId      Int
  senderName  String        @db.VarChar(150)
  senderEmail String        @db.VarChar(255)
  subject     String?       @db.VarChar(200)
  message     String        @db.Text
  status      MessageStatus @default(UNREAD)
  createdAt   DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_contact_messages")
}

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model CustomDomain {
  id                 Int                @id @default(autoincrement())
  userId             Int
  domain             String             @unique @db.VarChar(255)
  verificationStatus VerificationStatus @default(PENDING)
  cnameTarget        String?            @db.VarChar(255)
  createdAt          DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_custom_domains")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

model Subscription {
  id        Int                @id @default(autoincrement())
  userId    Int                @unique
  plan      Plan               @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("codefolio_subscriptions")
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model VersionSnapshot {
  id             Int      @id @default(autoincrement())
  userId         Int
  versionName    String   @default("Snapshot") @db.VarChar(100)
  profileData    Json?
  projectsData   Json?
  skillsData     Json?
  socialLinksData Json?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])

  @@map("codefolio_version_snapshots")
}
